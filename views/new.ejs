<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write new chat</title>
    <link rel="stylesheet" href="/new.css">
</head>
<body>
    <h3  class="page-title"> Write new chat...</h3>
   <form  method ="post" action = "/chats" class="chat-form" >
    <input type="text" placeholder="Who are you?" name="from" required>
    <br/>

    <textarea name="msg" placeholder="Write your message here..." required></textarea>
    <br/>

    <input type="text" placeholder="Add receiver" name="to" required>
    <br/>

    <button type="submit">Create Chat</button>
</form>
</body>
</html>

