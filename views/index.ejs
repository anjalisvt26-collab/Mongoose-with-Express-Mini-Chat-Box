
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>All chats</h3>
    <form method="GET" action="/chats/new">
        <button class="new-chat-btn" >New chat</button>
    </form>
    <br/>
    <% for(let chat of chats){ %>
        <div class="chat">
            <p> from:<%= chat.from%> </p>
            <div class = "msg">
                <p> <%= chat.msg %> </p>
                <div>
                <form method ="GET" action ="/chats/<%=chat._id%>/edit">
                    <button class="edit-btn">Edit</button>
                </form>
                    <br/>
                <form method ="POST" action ="/chats/<%=chat._id%>?_method=DELETE">
                    <button class="delete-btn">Delete</button>
                </form>
                </div>
            </div>             
              <p> Received by :<%= chat.to%> </p>
               
        <hr/>
        <p><%= chat.created_at.toString().split(" ")[4] %></p>
        <p><%= chat.created_at.toString().split(" ").slice(1,4).join("-")%></p>
        </div>

    <% } %>

    
</body>
</html>
